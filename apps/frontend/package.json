{
  "name": "@lostrpg/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "dev:mock": "bunx --bun vite --mode mock",
    "prebuild": "bun tsc -b",
    "build": "vite build",
    "lint": "eslint . --fix && bun tsc -b",
    "preview": "bunx --bun vite preview",
    "prepreview:ci": "tsc -b && bunx --bun vite build --mode ci",
    "preview:ci": "bunx --bun vite preview --port 5173 ",
    "test": "vitest run",
    "test:watch": "vitest",
    "ncu": "ncu -u",
    "upgrade-msw": "bunx msw init public --save"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@lostrpg/backend": "workspace:*",
    "@lostrpg/core": "workspace:*",
    "@lostrpg/schemas": "workspace:*",
    "@lostrpg/ui": "workspace:*",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.10.1",
    "@mui/x-tree-view": "^9.12.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@zip.js/zip.js": "^2.8.34",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "hono": "^4.12.32",
    "lodash": "^4.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@lostrpg/eslint-config-custom": "workspace:*",
    "@lostrpg/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "msw": "^2.15.0",
    "npm-check-updates": "^23.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
